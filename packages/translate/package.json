{
  "name": "@cliff-format/translate",
  "version": "0.2.0",
  "description": "CLIFF-native translation with the DeepSeek API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cliff-format/core": "^0.2.0"
  },
  "devDependencies": {
    "@cliff-format/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cliff-format/cliff-js.git",
    "directory": "packages/translate"
  },
  "keywords": [
    "cliff",
    "i18n",
    "l10n",
    "localization",
    "translation",
    "deepseek"
  ],
  "homepage": "https://github.com/cliff-format/cliff-js#readme",
  "bugs": {
    "url": "https://github.com/cliff-format/cliff-js/issues"
  }
}
