{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cliff-format/core": ["packages/core/src/index.ts"],
      "@cliff-format/i18n": ["packages/i18n/src/index.ts"],
      "@cliff-format/i18n/lite": ["packages/i18n/src/lite.ts"],
      "@cliff-format/i18n/react": ["packages/i18n/src/react.ts"],
      "@cliff-format/translate": ["packages/translate/src/index.ts"],
      "@cliff-format/vite": ["packages/vite/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "vitest.config.ts"]
}
